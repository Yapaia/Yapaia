      ]
    },
    {
      "name": "gps_verloren",
      "titel": {
        "de": "GPS verloren",
        "en": "GPS lost"
      }
    },
    {
      "name": "neuberechnung_fehlgeschlagen",
      "titel": {
        "de": "Neuberechnung fehlgeschlagen",
        "en": "Reroute failed"
      }
    }
  ]
